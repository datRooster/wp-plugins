{
	"name": "datrooster/wp-plugins",
	"description": "Monorepo for WordPress plugins maintained by DatRooster.",
	"type": "project",
	"license": "GPL-2.0-or-later",
	"require-dev": {
		"dealerdirect/phpcodesniffer-composer-installer": "^1.1",
		"phpcompatibility/phpcompatibility-wp": "^2.1",
		"wp-coding-standards/wpcs": "^3.1"
	},
	"scripts": {
		"lint:php": [
			"find plugins -name '*.php' -not -path '*/vendor/*' -print0 | xargs -0 -n1 php -l"
		],
		"lint:phpcs": [
			"phpcs"
		]
	},
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		}
	}
}
