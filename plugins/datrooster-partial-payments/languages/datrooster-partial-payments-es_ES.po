#: /Applications/MAMP/htdocs/wp-plugins/plugins/datrooster-partial-payments/src/Cart/DepositCartManager.php:677
#: /Applications/MAMP/htdocs/wp-plugins/plugins/datrooster-partial-payments/src/Frontend/ProductSelection.php:85
msgid "Payment options"
msgstr "Opciones de pago"

#: /Applications/MAMP/htdocs/wp-plugins/plugins/datrooster-partial-payments/src/Cart/DepositCartManager.php:709
msgid ""
"Your cart qualifies for partial payments. Choose whether to pay in full or "
"leave the configured deposit today."
msgstr ""
"Tu carrito ya permite pagos parciales. Elige si pagar el importe completo o "
"dejar hoy el deposito configurado."

#: /Applications/MAMP/htdocs/wp-plugins/plugins/datrooster-partial-payments/src/Cart/DepositCartManager.php:722
msgid "Please log in to use deposits on this order."
