#: /Applications/MAMP/htdocs/wp-plugins/plugins/datrooster-partial-payments/src/Cart/DepositCartManager.php:126
#, php-format
msgid ""
"Deposits become available only when the product or cart products total "
"reaches %s."
msgstr ""
"Los depositos solo estaran disponibles cuando el producto o el total de "
"productos del carrito alcance %s."

#: /Applications/MAMP/htdocs/wp-plugins/plugins/datrooster-partial-payments/src/Cart/DepositCartManager.php:135
msgid "Please log in before purchasing this product with a deposit."
msgstr "Inicia sesion antes de comprar este producto con deposito."

#: /Applications/MAMP/htdocs/wp-plugins/plugins/datrooster-partial-payments/src/Cart/DepositCartManager.php:204
