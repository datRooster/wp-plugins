msgstr "No tienes permisos para gestionar Cupones del tesoro."

#: src/Admin/SettingsPage.php:259
msgid "DatRooster Treasure Coupons"
msgstr "DatRooster Cupones del tesoro"

#: src/Admin/SettingsPage.php:262
